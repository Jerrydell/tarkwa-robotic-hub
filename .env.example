# Get these from your Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Only needed for admin scripts / server-only operations that bypass RLS.
# NEVER prefix this with NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Powers the AI-assisted lesson/quiz drafting feature in the admin panel
# Get a free key at https://openrouter.ai — no card required.
OPENROUTER_API_KEY=your-openrouter-api-key
